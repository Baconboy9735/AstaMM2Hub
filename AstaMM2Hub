local function isCoinBagFull()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local main = gui and gui:FindFirstChild("MainGUI")
    local gameUI = main and main:FindFirstChild("Game")
    local bags = gameUI and gameUI:FindFirstChild("CoinBags")
    local container = bags and bags:FindFirstChild("Container")
    if not container then return false end

    for _, name in ipairs({ "Candy", "Coin" }) do
        local bag = container:FindFirstChild(name)
        if bag and bag:IsA("GuiObject") and bag.Visible then
            local full = bag:FindFirstChild("Full")
            local icon = bag:FindFirstChild("FullBagIcon")
            if (full and full:IsA("GuiObject") and full.Visible)
                or (icon and icon:IsA("GuiObject") and icon.Visible) then
                return true
            end
        end
    end
    return false
end

-- Keep one tween and one destination; only pause/resume during long trips.
local function moveStep(character, root, humanoid, destination, facing, stillNeeded)
    if not state.running or not settings.Master or player.Character ~= character
        or not root.Parent or humanoid.Health <= 0 then return end

    local distance = (root.Position - destination).Magnitude
    if distance <= 0.15 then return end

    local goal = CFrame.new(destination) * root.CFrame.Rotation
    if facing and (facing - destination).Magnitude > 0.01 then
        goal = CFrame.lookAt(destination, facing)
    end

    local duration = math.max(distance / settings.Speed, 0.05)
    local tween = TweenService:Create(root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = goal })
    state.tween = tween
    tween:Play()
    local deadline = os.clock() + duration
        + math.ceil(duration / settings.PauseInterval) * settings.PauseDuration + 2
    local nextPause = os.clock() + settings.PauseInterval

    local function interrupted()
        return not state.running or not settings.Master or player.Character ~= character
            or not root.Parent or humanoid.Health <= 0
            or (stillNeeded and not stillNeeded())
    end

    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if interrupted() or os.clock() >= deadline then
            tween:Cancel()
            break
        end
        if settings.MovementPauses and os.clock() >= nextPause then
            tween:Pause()
            task.wait(settings.PauseDuration)
            if interrupted() or tween.PlaybackState == Enum.PlaybackState.Cancelled then
                tween:Cancel()
                break
            end
            if tween.PlaybackState == Enum.PlaybackState.Paused then
                tween:Play()
            end
            nextPause = os.clock() + settings.PauseInterval
        end
        task.wait(0.03)
    end
    if state.tween == tween then state.tween = nil end
end

local function getWeapon(character, name)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local tool = character:FindFirstChild(name)
        or (backpack and backpack:FindFirstChild(name))
    if tool and tool:IsA("Tool") then return tool end
end

local function findTarget(root, sheriffMode)
    local target, nearest = nil, math.huge
    for _, other in Players:GetPlayers() do
        local info = roundData[other.Name]
        local character = other.Character
        local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if other ~= player and type(info) == "table"
            and not info.Dead and not info.Killed
            and (not sheriffMode or info.Role == "Murderer")
            and other:GetAttribute("Alive") ~= false
            and otherRoot and humanoid and humanoid.Health > 0
            and not character:FindFirstChildOfClass("ForceField") then
            local distance = (root.Position - otherRoot.Position).Magnitude
            if distance < nearest then
                nearest = distance
                target = { player = other, character = character,
                    root = otherRoot, humanoid = humanoid }
            end
        end
    end
    return target
end

local function targetAlive(target)
    local info = roundData[target.player.Name]
    return type(info) == "table" and not info.Dead and not info.Killed
        and target.player.Character == target.character
        and target.root.Parent ~= nil and target.humanoid.Health > 0
        and target.player:GetAttribute("Alive") ~= false
        and not target.character:FindFirstChildOfClass("ForceField")
end

local function clearShot(character, origin, destination, targetCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local hit = workspace:Raycast(origin, destination - origin, params)
    return not hit or hit.Instance:IsDescendantOf(targetCharacter)
end

-- Aim Assist v3: restored the proven v1 Scriptable-camera lock while aiming.
-- The v2 'Scriptable camera' veto could disable aim completely. V3 never vetoes it.
local aimRunService = game:GetService("RunService")
local aimInput = game:GetService("UserInputService")
local aimLock, lockedTarget
local windowFocused = true
local buttonDown = {}

-- Body aim by default; optional upper-chest/head aiming.
local function getAimPoint(target)
    local preferred
    if settings.AimHead then
        preferred = target.character:FindFirstChild("Head")
    else
        preferred = target.character:FindFirstChild("UpperTorso")
            or target.character:FindFirstChild("Torso")
    end
    local part = preferred or target.root
    local point = part.Position
    if part == target.root then point = point + Vector3.new(0, 0.6, 0) end
    if part.Name == "Head" then point = point - Vector3.new(0, 0.12, 0) end
    return point, part.Name
end

-- Poll the live key state AND track events for input modes that swallow button presses.
table.insert(state.hubConnections, aimInput.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        buttonDown[input.KeyCode.Name] = true
    else
        local name = input.UserInputType.Name
        if name == "MouseButton1" or name == "MouseButton2" or name == "MouseButton3" then
            buttonDown[name] = true
        end
    end
end))
table.insert(state.hubConnections, aimInput.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        buttonDown[input.KeyCode.Name] = nil
    else
        buttonDown[input.UserInputType.Name] = nil
    end
end))
local function aimKeyHeld()
    local key = settings.AimKey
    if key == "MouseButton1" or key == "MouseButton2" or key == "MouseButton3" then
        return buttonDown[key] or aimInput:IsMouseButtonPressed(Enum.UserInputType[key])
    end
    local keyEnum = Enum.KeyCode[key]
    return buttonDown[key] or (keyEnum and aimInput:IsKeyDown(keyEnum)) or false
end

state.aimBinding = "AstaMM2Aim_" .. HttpService:GenerateGUID(false)
state.releaseAim = function()
    if aimLock then
        local saved = aimLock
        aimLock = nil
        if saved.camera and saved.camera.Parent then
            -- Restore Roblox's camera ownership and subject on release.
            if saved.camera.CameraType == Enum.CameraType.Scriptable then
                saved.camera.CameraType = saved.cameraType
            end
            if saved.subject and saved.subject.Parent then
                saved.camera.CameraSubject = saved.subject
            end
        end
        aimInput.MouseBehavior = saved.mouseBehavior
    end
    lockedTarget = nil
    state.aimLocked = false
    state.aimTargetPart = nil
    state.aimErrorDegrees = nil
end
state.stopAim = function()
    aimRunService:UnbindFromRenderStep(state.aimBinding)
    state.releaseAim()
end

table.insert(state.hubConnections, aimInput.WindowFocusReleased:Connect(function()
    windowFocused = false
    buttonDown = {}
    state.releaseAim()
end))
table.insert(state.hubConnections, aimInput.WindowFocused:Connect(function()
    windowFocused = true
end))

local function updateAim(delta)
    if not state.running then state.stopAim() return end
    local function idle(message)
        state.releaseAim()
        state.aimStatus = message
    end
    if not settings.Master or not settings.AimAssist then idle("Disabled") return end
    if not windowFocused then idle("Window inactive") return end
    if state.aimKeyCapture then idle("Choosing activation key") return end
    if aimInput:GetFocusedTextBox() then idle("Typing") return end
    if not aimKeyHeld() then idle("Hold " .. aimKeyLabel() .. " to lock on") return end

    local ownCharacter, root = getCharacter()
    if not ownCharacter then idle("Waiting for character") return end
    local ownInfo = roundData[player.Name]
    if type(ownInfo) ~= "table" or ownInfo.Dead or ownInfo.Killed
        or player:GetAttribute("Alive") == false then
        idle("Waiting for active round") return
    end
    if ownInfo.Role == "Murderer" then idle("You are the Murderer") return end

    local camera = workspace.CurrentCamera
    if not camera then idle("Waiting for camera") return end
    if lockedTarget then
        local info = roundData[lockedTarget.player.Name]
        if not targetAlive(lockedTarget) or type(info) ~= "table"
            or info.Role ~= "Murderer" then
            lockedTarget = nil
        end
    end
    if not lockedTarget then
        local candidate = findTarget(root, true)
        if candidate then
            lockedTarget = candidate
        end
    end
    if not lockedTarget then idle("No living Murderer found") return end

    local target = lockedTarget
    local predicted, aimPart = getAimPoint(target)

    -- Unlike v2, this lock works even if Roblox or another camera script
    -- is using Scriptable mode. Save / restore the original camera state.
    if aimLock and (aimLock.camera ~= camera or aimLock.character ~= ownCharacter) then
        state.releaseAim()
        lockedTarget = target
    end
    if not aimLock then
        aimLock = {
            camera = camera,
            character = ownCharacter,
            cameraType = camera.CameraType,
            subject = camera.CameraSubject,
            mouseBehavior = aimInput.MouseBehavior,
            offset = camera.CFrame.Position - root.Position,
            position = camera.CFrame.Position,
        }
    end
    local desiredPosition = root.Position + aimLock.offset
    local posAlpha = 1 - math.exp(-18 * math.clamp(delta, 0, 0.1))
    aimLock.position = aimLock.position:Lerp(desiredPosition, posAlpha)
    local origin = aimLock.position
    if (predicted - origin).Magnitude < 0.1 then idle("Target too close") return end

    camera.CameraType = Enum.CameraType.Scriptable
    aimInput.MouseBehavior = Enum.MouseBehavior.LockCenter
    local desired = CFrame.lookAt(origin, predicted)
    camera.CFrame = desired
    camera.Focus = CFrame.new(predicted)

    local toTarget = (predicted - origin).Unit
    state.aimErrorDegrees = math.deg(math.acos(math.clamp(
        camera.CFrame.LookVector:Dot(toTarget), -1, 1)))
    state.aimTargetPart = aimPart
    state.aimLocked = true
    state.aimStatus = "Locked: " .. target.player.DisplayName .. " (" .. aimPart .. ")"
end

-- Capture errors instead of silently losing every subsequent frame.
local lastAimWarning = 0
aimRunService:BindToRenderStep(state.aimBinding,
    Enum.RenderPriority.Camera.Value + 1, function(delta)
        local ok, err = pcall(updateAim, delta)
        if not ok then
            state.releaseAim()
            state.aimStatus = "Aim error: " .. tostring(err)
            if os.clock() - lastAimWarning >= 3 then
                lastAimWarning = os.clock()
                warn("Asta aimbot: " .. tostring(err))
            end
        end
    end)

local function handleCombat(character, root, humanoid, own)
    local sheriffMode = own.Role == "Sheriff"
    if not sheriffMode and own.Role ~= "Murderer" then return false end
    local function combatEnabled()
        local current = roundData[player.Name]
        return state.running and settings.Master and type(current) == "table"
            and current.Role == own.Role and not current.Dead and not current.Killed
            and (sheriffMode and settings.AutoSheriff or not sheriffMode and settings.AutoMurderer)
            and (not settings.WaitForFullBag or isCoinBagFull())
    end
    if not combatEnabled() then return false end
    local weapon = getWeapon(character, sheriffMode and "Gun" or "Knife")
    if not weapon then return false end
    local target = findTarget(root, sheriffMode)
    if not target then return false end
    if weapon:GetAttribute("Disabled") == true then
        task.wait(0.2)
        return true
    end
    if weapon.Parent ~= character then
        humanoid:EquipTool(weapon)
        task.wait(0.2)
    end
    if not combatEnabled() or player.Character ~= character
        or humanoid.Health <= 0 or weapon.Parent ~= character
        or not targetAlive(target) then return true end

    local distance = (root.Position - target.root.Position).Magnitude
    if sheriffMode then
        local attachment = root:FindFirstChild("GunRaycastAttachment")
        local shoot = weapon:FindFirstChild("Shoot")
        if attachment and attachment:IsA("Attachment")
            and shoot and shoot:IsA("RemoteEvent") then
            local aimPosition, unpredicted = getAimPoint(target)
            local origin = attachment.WorldPosition
            local head = character:FindFirstChild("Head")
            local muzzleClear = head and clearShot(
                character, head.Position, origin, target.character)
            if distance <= SHOOT_RANGE and muzzleClear
                and clearShot(character, origin, unpredicted, target.character) then
                if os.clock() - lastShot >= SHOT_DELAY then
                    lastShot = os.clock()
                    shoot:FireServer(attachment.WorldCFrame, CFrame.new(aimPosition))
                end
                task.wait(0.15)
                return true
            end
        end
        local destination = (target.root.CFrame * CFrame.new(0, 0, 12)).Position
        moveStep(character, root, humanoid, destination, target.root.Position, function()
            return combatEnabled() and targetAlive(target)
        end)
    else
        if distance > 3 then
            local destination = (target.root.CFrame * CFrame.new(0, 0, 2)).Position
            moveStep(character, root, humanoid, destination, target.root.Position, function()
                return combatEnabled() and targetAlive(target)
            end)
        end
        local currentOwn = roundData[player.Name]
        if combatEnabled() and player.Character == character and humanoid.Health > 0
            and type(currentOwn) == "table" and currentOwn.Role == "Murderer"
            and not currentOwn.Dead and not currentOwn.Killed
            and targetAlive(target) and weapon.Parent == character
            and (root.Position - target.root.Position).Magnitude <= 4
            and os.clock() - lastStab >= STAB_DELAY then
            lastStab = os.clock()
            weapon:Activate()
        end
        task.wait(0.1)
    end
    return true
end

local gunRetry = setmetatable({}, { __mode = "k" })
local function collectDroppedGun(character, root, humanoid, own)
    if not settings.Master or not settings.AutoGunPickup or own.Role == "Murderer"
        or getWeapon(character, "Gun") then return false end
    local nearest, target, part = math.huge, nil, nil
    for _, drop in workspace:QueryDescendants("#GunDrop, #DroppedGun") do
        local candidate = drop:IsA("BasePart") and drop
            or (drop:IsA("Model") and (drop.PrimaryPart or drop:FindFirstChildWhichIsA("BasePart", true)))
        if candidate and os.clock() >= (gunRetry[drop] or 0) then
            local distance = (root.Position - candidate.Position).Magnitude
            if distance < nearest then nearest, target, part = distance, drop, candidate end
        end
    end
    if not target then return false end
    state.mode = "Collecting dropped gun"
    moveStep(character, root, humanoid, part.Position + Vector3.new(0, 2, 0), nil, function()
        local current = roundData[player.Name]
        return settings.AutoGunPickup and target:IsDescendantOf(workspace)
            and part:IsDescendantOf(workspace) and not getWeapon(character, "Gun")
            and type(current) == "table" and current.Role ~= "Murderer"
            and not current.Dead and not current.Killed
    end)
    if not state.running or not settings.Master or not settings.AutoGunPickup then return true end
    local deadline = os.clock() + 0.6
    while state.running and settings.Master and settings.AutoGunPickup
        and player.Character == character and humanoid.Health > 0
        and target:IsDescendantOf(workspace) and not getWeapon(character, "Gun")
        and os.clock() < deadline do task.wait(0.05) end
    if not getWeapon(character, "Gun") then gunRetry[target] = os.clock() + 3 end
    return true
end

local function collectCoin(character, root, humanoid)
    if not settings.Master or not settings.AutoFarm then return end
    local target, nearest = nil, math.huge
    for _, coin in workspace:QueryDescendants("#CoinContainer > #Coin_Server") do
        if coin:IsA("BasePart") and coin:GetAttribute("Collected") ~= true
            and os.clock() >= (retryAfter[coin] or 0) then
            local distance = (root.Position - coin.Position).Magnitude
            if distance < nearest then
                nearest, target = distance, coin
            end
        end
    end
    if not target then task.wait(0.5) return end
    local destination = target.Position + Vector3.new(0, 2, 0)
    moveStep(character, root, humanoid, destination, nil, function()
        return settings.Master and settings.AutoFarm
            and target.Parent ~= nil and target:GetAttribute("Collected") ~= true
            and not isCoinBagFull()
    end)
    if not state.running or not settings.Master or not settings.AutoFarm
        or player.Character ~= character then return end
    -- Allow the collection flag to update instead of assuming proximity is success.
    local confirmDeadline = os.clock() + 0.3
    while state.running and settings.Master and settings.AutoFarm
        and player.Character == character and humanoid.Health > 0
        and target.Parent and target:GetAttribute("Collected") ~= true
        and not isCoinBagFull() and os.clock() < confirmDeadline do
        task.wait(0.03)
    end
    if not state.running or player.Character ~= character then return end
    if target.Parent and target:GetAttribute("Collected") ~= true then
        retryAfter[target] = os.clock() + 2
    end
    task.wait(settings.CoinDelay)
end

local function isVisible(button, gui)
    if not button.Active then return false end
    local current = button
    while current and current ~= gui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return current == gui
end

