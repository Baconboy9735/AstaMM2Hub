-- Buy one Halloween box when the confirmed balance covers its price.
-- Keep a shared pending record across script restarts to avoid duplicate requests.
task.spawn(function()
    local initialized, setupError = pcall(function()
        local profile = require(ReplicatedStorage.Modules.ProfileData)
        local sync = require(ReplicatedStorage.Database.Sync)
        local policy = require(ReplicatedStorage.ClientServices.PolicyManager)
        local shop = ReplicatedStorage.Remotes.Shop
        local nextAttempt = 0

        local function balance(currency)
            local owned = profile.Materials and profile.Materials.Owned
            return owned and tonumber(owned[currency]) or 0
        end

        local function popupOpen()
            local gui = player:FindFirstChildOfClass("PlayerGui")
            if not gui then return true end
            if gui:FindFirstChild("MysteryBoxOpen") then return true end
            local cross = gui:FindFirstChild("CrossPlatform")
            local popup = cross and cross:FindFirstChild("NewItem")
            local medium = popup and popup:FindFirstChild("Medium")
            local container = medium and medium:FindFirstChild("Container")
            local claim = container and container:FindFirstChild("Claim")
            return claim and claim:IsA("GuiButton") and isVisible(claim, gui)
        end

        while state.running do
            local current = balance(CANDY_CURRENCY)
            local keys = balance(BOX_KEY_CURRENCY)
            local pending = env.MM2CandyPurchasePending

            if pending then
                state.purchaseStatus = "Waiting for purchase confirmation"
                -- Never reissue while the previous server call is unresolved.
                -- Older script copies stored Candy purchases without currency/price.
                local pendingCurrency = pending.currency or CANDY_CURRENCY
                local pendingPrice = pending.price or CANDY_BOX_PRICE
                if pending.finished
                    and balance(pendingCurrency) <= pending.before - pendingPrice then
                    env.MM2CandyPurchasePending = nil
                    nextAttempt = os.clock() + 8
                end
            elseif settings.Master and (settings.CandyBoxes or settings.KeyBoxes)
                and os.clock() >= nextAttempt then
                local box = sync.NewShop and sync.NewShop[CANDY_BOX_ID]
                local prices = box and box.Price or {}
                local currency, price, available
                -- Spend event keys first; otherwise use 600 Candy.
                if settings.KeyBoxes and keys >= BOX_KEY_PRICE
                    and prices[BOX_KEY_CURRENCY] == BOX_KEY_PRICE then
                    currency, price, available = BOX_KEY_CURRENCY, BOX_KEY_PRICE, keys
                elseif settings.CandyBoxes and current >= CANDY_BOX_PRICE
                    and prices[CANDY_CURRENCY] == CANDY_BOX_PRICE then
                    currency, price, available = CANDY_CURRENCY, CANDY_BOX_PRICE, current
                end
                if policy.ArePaidRandomItemsRestricted ~= false then
                    state.purchaseStatus = "Random boxes unavailable for this account"
                elseif not currency then
                    state.purchaseStatus = "Waiting for 1 Halloween key or 600 Candy; keys="
                        .. keys .. ", Candy=" .. current
                elseif not popupOpen() and state.running then
                    local transaction = { before = available, finished = false,
                        currency = currency, price = price }
                    env.MM2CandyPurchasePending = transaction
                    state.purchaseStatus = "Opening Halloween Box '26 with " .. currency

                    local ok, reward = pcall(function()
                        return shop.OpenCrate:InvokeServer(
                            CANDY_BOX_ID, "MysteryBox", currency)
                    end)
                    transaction.finished = true

                    if ok and reward then
                        state.cratesOpened = state.cratesOpened + 1
                        transaction.reward = reward
                        state.purchaseStatus = "Purchased; waiting for balance update"
                        -- Use the game's normal opening and reward presentation.
                        local shown, showError = pcall(function()
                            shop.BoxController:Fire({ {
                                MysteryBoxId = CANDY_BOX_ID,
                                RewardedItemId = reward
                            } })
                        end)
                        if not shown then warn("Box display: " .. tostring(showError)) end
                    elseif ok then
                        -- The server explicitly rejected the purchase.
                        if env.MM2CandyPurchasePending == transaction then
                            env.MM2CandyPurchasePending = nil
                        end
                        state.purchaseStatus = "Purchase rejected; waiting before retry"
                        nextAttempt = os.clock() + 15
                    else
                        -- An uncertain response must not immediately cause another spend.
                        state.purchaseStatus = "Uncertain purchase; waiting for balance confirmation"
                        warn("Box purchase: " .. tostring(reward))
                    end
                end
            end
            task.wait(2)
        end
    end)
    if not initialized then
        state.purchaseStatus = "Auto-buy stopped: " .. tostring(setupError)
        warn(state.purchaseStatus)
    end
end)

-- Local ESP: red Murderer, blue Sheriff, with role labels.
local espFolder = Instance.new("Folder")
espFolder.Name = "MM2RoleESP"
espFolder.Parent = workspace
state.espFolder = espFolder
local espEntries = {}
local roleColors = {
    Murderer = Color3.fromRGB(255, 60, 60),
    Sheriff = Color3.fromRGB(60, 150, 255)
}

local function removeESP(other)
    local entry = espEntries[other]
    if entry then
        entry.highlight:Destroy()
        entry.billboard:Destroy()
        espEntries[other] = nil
    end
end

local function updateESP()
    local seen = {}
    for _, other in Players:GetPlayers() do
        local info = roundData[other.Name]
        local character = other.Character
        local head = character and character:FindFirstChild("Head")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local color = type(info) == "table" and roleColors[info.Role]
        local roleEnabled = type(info) == "table" and
            ((info.Role == "Murderer" and settings.MurdererESP)
            or (info.Role == "Sheriff" and settings.SheriffESP))
        if settings.Master and settings.ESP and roleEnabled
            and other ~= player and color and head and humanoid
            and humanoid.Health > 0 and not info.Dead and not info.Killed
            and other:GetAttribute("Alive") ~= false then
            seen[other] = true
            local entry = espEntries[other]
            if entry and (entry.character ~= character
                or entry.billboard.Adornee ~= head) then
                removeESP(other)
                entry = nil
            end
            if not entry then
                local highlight = Instance.new("Highlight")
                highlight.Name = "RoleHighlight"
                highlight.Adornee = character
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.FillTransparency = 0.65
                highlight.OutlineTransparency = 0
                highlight.FillColor = color
                highlight.OutlineColor = color
                highlight.Parent = espFolder

                local billboard = Instance.new("BillboardGui")
                billboard.Name = "RoleLabel"
                billboard.Adornee = head
                billboard.AlwaysOnTop = true
                billboard.Size = UDim2.fromOffset(220, 44)
                billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                billboard.MaxDistance = 1500
                billboard.Parent = espFolder

                local label = Instance.new("TextLabel")
                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 15
                label.TextStrokeTransparency = 0.2
                label.TextColor3 = color
                label.Parent = billboard
                entry = { character = character, highlight = highlight,
                    billboard = billboard, label = label }
                espEntries[other] = entry
            end
            entry.highlight.FillColor = color
            entry.highlight.OutlineColor = color
            entry.label.TextColor3 = color
            entry.label.Text = info.Role .. "\n" .. other.DisplayName
            entry.billboard.Enabled = settings.ESPNames
        end
    end
    local expired = {}
    for other in pairs(espEntries) do
        if not seen[other] then table.insert(expired, other) end
    end
    for _, other in ipairs(expired) do removeESP(other) end
end

state.refreshESP = updateESP
task.spawn(function()
    while state.running do
        local ok, err = pcall(updateESP)
        if not ok then
            warn("Role ESP: " .. tostring(err))
            task.wait(1)
        end
        task.wait(0.25)
    end
    espFolder:Destroy()
end)

-- Coins first; combat starts only when the bag is full.
task.spawn(function()
    while state.running do
        local ok, err = pcall(function()
            if not settings.Master then state.mode = "Paused" task.wait(0.2) return end
            local character, root, humanoid = getCharacter()
            if not character then state.mode = "Waiting for character" task.wait(0.5) return end
            local own = roundData[player.Name]
            if type(own) ~= "table" or own.Dead or own.Killed
                or player:GetAttribute("Alive") == false then
                state.mode = "Waiting for round"
                task.wait(0.5)
                return
            end
            local full = isCoinBagFull()
            if collectDroppedGun(character, root, humanoid, own) then return end
            if (full or not settings.WaitForFullBag)
                and handleCombat(character, root, humanoid, own) then return end
            if settings.AutoFarm and not full then
                state.mode = "Collecting coins"
                collectCoin(character, root, humanoid)
                return
            end
            state.mode = settings.WaitForFullBag and not full
                and "Waiting for full bag" or "Idle"
            task.wait(0.2)
        end)
        if not ok then
            cancelTween()
            state.mode = "Retrying"
            warn("MM2 automation: " .. tostring(err))
            task.wait(1)
        end
        task.wait(0.05)
    end
    cancelTween()
end)

