local settings = {
    Master = true, AutoFarm = true, AutoMurderer = true, AutoSheriff = true,
    WaitForFullBag = true, AutoClaim = true, MovementPauses = true,
    ESP = true, MurdererESP = true, SheriffESP = true, ESPNames = true,
    CandyBoxes = true, KeyBoxes = true, RGB = true,
    AimAssist = false, AutoGunPickup = false, AimKey = "MouseButton2",
    AimHead = false,
    Speed = 30, CoinDelay = 0.1, PauseInterval = 1, PauseDuration = 0.03
}
state.settings = settings
local ranges = { Speed = { 8, 50 }, CoinDelay = { 0, 1 },
    PauseInterval = { 0.25, 3 }, PauseDuration = { 0.01, 0.3 } }
local defaults = table.clone(settings)
local function validAimKey(value)
    if type(value) ~= "string" then return false end
    if value == "MouseButton1" or value == "MouseButton2" or value == "MouseButton3" then return true end
    local ok, key = pcall(function() return Enum.KeyCode[value] end)
    return ok and key ~= nil and key ~= Enum.KeyCode.Unknown and key ~= Enum.KeyCode.Escape
end
local function aimKeyLabel()
    local labels = { MouseButton1 = "Left mouse", MouseButton2 = "Right mouse", MouseButton3 = "Middle mouse" }
    return labels[settings.AimKey] or settings.AimKey
end
local HttpService = game:GetService("HttpService")
local configFolder = "AstaMM2Hub"
local configPath = configFolder .. "/config_" .. tostring(player.UserId) .. ".json"
state.configPath = configPath
local function applyConfig(values)
    if type(values) ~= "table" then return false end
    for key, default in pairs(defaults) do
        local value = values[key]
        if type(value) == type(default) then
            if type(value) == "number" then
                if value == value and math.abs(value) < math.huge then
                    if ranges[key] then
                        settings[key] = math.clamp(value, ranges[key][1], ranges[key][2])
                    else
                        settings[key] = value
                    end
                end
            elseif key == "AimKey" then
                if validAimKey(value) then settings[key] = value end
            else settings[key] = value end
        end
    end
    return true
end
if not state.preview then
    applyConfig(env.AstaMM2SavedSettings)
    if type(readfile) == "function" and type(isfile) == "function" then
        local ok, loaded = pcall(function()
            if not isfile(configPath) then return false end
            local decoded = HttpService:JSONDecode(readfile(configPath))
            assert(type(decoded) == "table" and decoded.version == 1, "Unsupported config")
            assert(applyConfig(decoded.settings), "Invalid settings")
            return true
        end)
        state.configStatus = ok and (loaded and "Config loaded" or "Ready / auto-save enabled")
            or "Config unreadable / defaults retained"
    else state.configStatus = "Session only / file API unavailable" end
else state.configStatus = "Preview / config writes disabled" end

local function saveConfig()
    if state.preview then state.configStatus = "Preview / config writes disabled" return false end
    env.AstaMM2SavedSettings = table.clone(settings)
    if type(writefile) ~= "function" or type(makefolder) ~= "function"
        or type(isfolder) ~= "function" then
        state.configStatus = "Session only / file API unavailable"
        return false
    end
    local ok = pcall(function()
        if not isfolder(configFolder) then makefolder(configFolder) end
        writefile(configPath, HttpService:JSONEncode({ version = 1, settings = settings }))
    end)
    state.configStatus = ok and "Saved automatically" or "Save failed / session copy retained"
    return ok
end
state.saveConfig = saveConfig
local movementSettings = { Master = true, AutoFarm = true, AutoMurderer = true,
    AutoSheriff = true, WaitForFullBag = true, Speed = true,
    AutoGunPickup = true,
    MovementPauses = true, PauseInterval = true, PauseDuration = true }
local function setSetting(key, value)
    if settings[key] == nil then return end
    if ranges[key] then
        if type(value) ~= "number" or value ~= value then return end
        value = math.clamp(value, ranges[key][1], ranges[key][2])
    elseif key == "AimKey" then
        if not validAimKey(value) then return end
    elseif type(value) ~= "boolean" then return end
    settings[key] = value
    if state.releaseAim and (key == "AimKey" or ((key == "AimAssist" or key == "Master") and not value)) then
        state.releaseAim()
    end
    -- Enabling a feature after Pause All resumes the hub without enabling other features.
    if key ~= "Master" and type(value) == "boolean" and value then settings.Master = true end
    if movementSettings[key] and state.tween then state.tween:Cancel() end
    if state.refreshESP then pcall(state.refreshESP) end
    saveConfig()
end
state.setSetting = setSetting
state.pauseAll = function()
    for key, value in pairs(settings) do
        if type(value) == "boolean" then settings[key] = false end
    end
    state.aimKeyCapture = false
    if state.releaseAim then state.releaseAim() end
    if state.tween then state.tween:Cancel() end
    if state.refreshESP then pcall(state.refreshESP) end
    saveConfig()
end
state.resetSettings = function()
    for key, value in pairs(defaults) do settings[key] = value end
    if state.tween then state.tween:Cancel() end
    if state.refreshESP then pcall(state.refreshESP) end
    saveConfig()
end
