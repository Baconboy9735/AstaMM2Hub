    env.AstaHubPreview.running = false
    if env.AstaHubPreview.hubGui then env.AstaHubPreview.hubGui:Destroy() end
    for _, connection in ipairs(env.AstaHubPreview.hubConnections or {}) do
        connection:Disconnect()
    end
