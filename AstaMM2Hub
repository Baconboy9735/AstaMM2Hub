    note.TextTruncate = Enum.TextTruncate.None
    local configCard = controlCard("Config", "ConfigInfo", 88)
    text(configCard, "Load/Save Config", 12, 12, 290, 22, 14, palette.text, true)
    local configStatus = text(configCard, state.configStatus or "Ready", 12, 43, 290, 34, 11, palette.cyan, true)
    configStatus.TextWrapped = true
    configStatus.TextTruncate = Enum.TextTruncate.None
    local function configAction(name, title, callback)
        local row = controlCard("Config", name, 46)
        local button = make("TextButton", {
            Name = "Action", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = title, TextColor3 = palette.text, Font = Enum.Font.GothamBold, TextSize = 12
        }, row)
        connect(button.Activated, callback)
    end
    configAction("Save", "Save settings now", function() state.saveConfig() end)
    configAction("Reset", "Reset to defaults", function() state.resetSettings() end)
    table.insert(controlRefreshers, function()
        configStatus.Text = state.configStatus == "Config loaded" and "Config Loaded"
            or state.configStatus or "Ready"
    end)
    selectTab("Stats")

    local collapsed, dragging, dragInput, dragStart, startPosition = false, false
    connect(minimize.Activated, function()
        collapsed = not collapsed
        for name, page in pairs(pages) do page.Visible = not collapsed and name == activeTab end
        tabBar.Visible = not collapsed
        stop.Visible = not collapsed
        panel.Size = UDim2.fromOffset(360, collapsed and 76 or 520)
        minimize.Text = collapsed and "+" or "−"
    end)
    connect(header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPosition = true, input.Position, panel.Position
            dragInput = input
        end
    end)
    connect(Input.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput then
            dragging = false
        end
    end)
    connect(Input.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input == dragInput) then
            local delta = input.Position - dragStart
            local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
            local x = startPosition.X.Offset + delta.X
            local y = startPosition.Y.Offset + delta.Y
            if viewport then
                x = math.clamp(x, 0, math.max(0, viewport.X - 360 * scale.Scale))
                y = math.clamp(y, 0, math.max(0, viewport.Y - 100))
            end
            panel.Position = UDim2.fromOffset(x, y)
        end
    end)
    connect(stop.Activated, function()
        state.pauseAll()
        for _, refresh in ipairs(controlRefreshers) do refresh() end
    end)

    local gameplay = ReplicatedStorage.Remotes:FindFirstChild("Gameplay")
    local collected = gameplay and gameplay:FindFirstChild("CoinCollected")
    local started = gameplay and gameplay:FindFirstChild("CoinsStarted")
    if collected then
        connect(collected.OnClientEvent, function(id, amount, capacity)
            if (id == "Candy" or id == "Coin") and tonumber(amount) then
                state.bagCounts[id] = { amount = tonumber(amount), capacity = tonumber(capacity) }
            end
        end)
    end
    if started then
        connect(started.OnClientEvent, function()
            state.bagCounts = {}
        end)
    end

    local function readBag()
        local main = player.PlayerGui:FindFirstChild("MainGUI")
        local gameUI = main and main:FindFirstChild("Game")
        local bags = gameUI and gameUI:FindFirstChild("CoinBags")
        local container = bags and bags:FindFirstChild("Container")
        if container then
            for _, id in ipairs({ "Candy", "Coin" }) do
                local bag = container:FindFirstChild(id)
                if bag and bag.Visible then
                    local known = state.bagCounts[id]
                    local currency = bag:FindFirstChild("CurrencyFrame")
                    local icon = currency and currency:FindFirstChild("Icon")
                    local coins = icon and icon:FindFirstChild("Coins")
                    local amount = coins and tonumber(coins.Text)
                    return amount or (known and known.amount), known and known.capacity
                end
            end
        end
    end
    -- Slow RGB sweep, limited to 30 updates/second and disconnected on shutdown.
    local rgbElapsed = 0
    connect(game:GetService("RunService").Heartbeat, function(delta)
        rgbElapsed = rgbElapsed + delta
        if rgbElapsed < 1 / 30 or not state.running or not gui.Parent then return end
        rgbElapsed = 0
        local hue = (os.clock() / 16) % 1
        local first = settings.RGB and Color3.fromHSV(hue, 0.55, 1) or palette.violet
        local middle = settings.RGB and Color3.fromHSV((hue + 0.16) % 1, 0.55, 1) or palette.violet
        local last = settings.RGB and Color3.fromHSV((hue + 0.32) % 1, 0.55, 1) or palette.cyan
        accentGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, first),
            ColorSequenceKeypoint.new(0.5, middle),
            ColorSequenceKeypoint.new(1, last)
        })
        border.Color = first
        monogram.TextColor3 = first
        for index, rgbDot in ipairs(rgbDots) do
            rgbDot.BackgroundColor3 = settings.RGB
                and Color3.fromHSV((hue + (index - 1) * 0.16) % 1, 0.55, 1) or palette.violet
        end
    end)
    while state.running and gui.Parent do
        local ok, err = pcall(function()
            for _, refresh in ipairs(controlRefreshers) do refresh() end
            stop.Text = "PAUSE ALL"
            local owned = profile.Materials and profile.Materials.Owned or {}
            candyText.Text = tostring(owned.Candies2026 or 0)
            keysText.Text = tostring(owned.HalloweenKey2026 or 0)
            cratesText.Text = tostring(state.cratesOpened or 0)
            levelText.Text = tostring(player:GetAttribute("Level") or "—")
            local amount, capacity = readBag()
            bagText.Text = tostring(amount or "—") .. " / " .. tostring(capacity or "—")
            fill.Size = UDim2.fromScale(
                amount and capacity and capacity > 0 and math.clamp(amount / capacity, 0, 1) or 0, 1)
            local elapsed = math.floor(os.clock() - state.startedAt)
            uptimeText.Text = string.format("SESSION  %02d:%02d:%02d",
                math.floor(elapsed / 3600), math.floor(elapsed / 60) % 60, elapsed % 60)
            local camera = workspace.CurrentCamera
            if camera then
                scale.Scale = math.clamp(math.min((camera.ViewportSize.X - 32) / 360,
                    (camera.ViewportSize.Y - 80) / 520), 0.5, 1)
            end
        end)
        if not ok then warn("Asta UI: " .. tostring(err)) end
        task.wait(0.25)
    end
    for _, connection in ipairs(state.hubConnections) do connection:Disconnect() end
    if state.stopAim then state.stopAim() end
    gui:Destroy()
end)
